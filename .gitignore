# ==============================================================================
# Agriculture Rover - Tailored Git Ignore Rules
# ==============================================================================

# Embedded & Microcontroller Build Artifacts (Arduino / ESP32 / PlatformIO / CMake)
*.hex
*.bin
*.elf
*.eep
*.srec
*.sym
*.lss
*.map
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
.pio/
.pioenvs/
.piolibdeps/

# Python Compilation & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.env

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Deep Learning Models & Training Runs
runs/
*.pt
!models/yolov8n_leaf_disease.pt
*.onnx
*.engine
*.tflite
*.params
dataset/
datasets/

# Large Video Files & Real-time Debug Logs (Keep READMEs inside)
assets/videos/*.mp4
assets/videos/*.mov
assets/videos/*.avi
assets/videos/*.mkv
snapshot_*.jpg
*.log

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
